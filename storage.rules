# ============================================================
#  Firebase Storage Security Rules — StayMate
#  Deploy with: firebase deploy --only storage
# ============================================================

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile Pictures ─────────────────────────────────────
    // Only the owner can upload/delete their picture; anyone can view
    match /profilePics/{userId}/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // max 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Property Images ──────────────────────────────────────
    // Anyone can view; only authenticated users can upload (admin validation via backend)
    match /properties/{propertyId}/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // max 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ── ID Proof Documents ───────────────────────────────────
    // Only the owner can upload/view their ID
    match /idProofs/{userId}/{fileName} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;  // max 10MB
    }
  }
}
