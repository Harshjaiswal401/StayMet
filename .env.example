# ============================================================
#  StayMate — Environment Variables Template
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your real Firebase values from Firebase Console
#  3. Add these same keys in Vercel Dashboard → Project → Settings → Environment Variables
#
#  ⚠️  NEVER commit .env to Git. It is already in .gitignore.
# ============================================================

# ── Firebase Configuration ───────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Config

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── App Configuration ────────────────────────────────────────
VITE_APP_NAME=StayMate
VITE_APP_ENV=development
